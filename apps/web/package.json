{
  "name": "@metastatistic/web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "node e2e/walkthrough.mjs",
    "e2e:reports": "node e2e/reports.mjs",
    "e2e:analyses": "node e2e/analyses.mjs",
    "e2e:dashboards": "node e2e/dashboards.mjs",
    "e2e:filters": "node e2e/dashboard-filters.mjs",
    "e2e:dash-analysis": "node e2e/dashboard-analysis.mjs && node e2e/builder.mjs",
    "e2e:auth": "node e2e/auth.mjs",
    "e2e:transform": "node e2e/transform.mjs",
    "e2e:builder": "node e2e/builder.mjs",
    "e2e:all": "node e2e/walkthrough.mjs && node e2e/reports.mjs && node e2e/analyses.mjs && node e2e/dashboards.mjs && node e2e/dashboard-filters.mjs && node e2e/dashboard-analysis.mjs"
  },
  "dependencies": {
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@uiw/react-codemirror": "^4.25.12",
    "echarts": "^6.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-grid-layout": "^2.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
