# Metastatistic — configuração do docker compose.
# Uso:  cp .env.example .env   e ajuste os valores. O arquivo .env NÃO é versionado (.gitignore).
# Tudo é opcional em desenvolvimento: o que ficar vazio usa o valor padrão de desenvolvimento.

# ---------------------------------------------------------------------------
# Ambiente
# ---------------------------------------------------------------------------
# development | production
# Com `production`, auth-tenant-service, gateway e billing-service RECUSAM iniciar se JWT_SECRET_KEY
# ou as credenciais do Stripe forem as de desenvolvimento (ver seções abaixo).
ENVIRONMENT=development

# ---------------------------------------------------------------------------
# Portas expostas no host
# ---------------------------------------------------------------------------
GATEWAY_PORT=8085
API_PORT=8020
R_WORKER_PORT=8011

# ---------------------------------------------------------------------------
# Sessão / autenticação do app
# ---------------------------------------------------------------------------
AUTH_ENABLED=true
# true quando o acesso for por HTTPS (cookies só trafegam em conexão segura)
COOKIE_SECURE=false

# ---------------------------------------------------------------------------
# JWT (auth-tenant-service emite os tokens; o gateway recebe a MESMA chave)
# ATENÇÃO: hoje o gateway ainda NÃO verifica a assinatura do JWT nem autentica o X-Tenant-ID
# (ver PLAN.md §7). Definir a chave é necessário, mas não suficiente, para isolar tenants.
# Gere uma com:  openssl rand -hex 32
# Em produção: obrigatória, com pelo menos 32 caracteres e diferente dos valores do repositório.
# ---------------------------------------------------------------------------
JWT_SECRET_KEY=

# ---------------------------------------------------------------------------
# Stripe (billing-service)
# STRIPE_MOCK_MODE=true simula checkout e webhooks (apenas desenvolvimento).
# Em produção: STRIPE_MOCK_MODE=false + chave secreta e segredo do webhook reais
# (Dashboard Stripe > Developers > API keys / Webhooks).
# ---------------------------------------------------------------------------
STRIPE_MOCK_MODE=true
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Garage (armazenamento de objetos compatível com S3: fotos de perfil)
# O serviço `garage-init` cria o layout, o bucket e importa a chave abaixo. O Garage NÃO publica portas no host.
# Os valores padrão de desenvolvimento servem só para uso local — em produção gere os seus:
#   S3_ACCESS_KEY      echo GK$(openssl rand -hex 12)     ("GK" + 24 caracteres hex)
#   S3_SECRET_KEY      openssl rand -hex 32               (64 caracteres hex)
#   GARAGE_RPC_SECRET  openssl rand -hex 32
#   GARAGE_ADMIN_TOKEN openssl rand -base64 32
# Trocar S3_SECRET_KEY depois da primeira subida exige remover a chave antiga:
#   docker compose exec garage /garage key delete --yes <S3_ACCESS_KEY>
# ---------------------------------------------------------------------------
S3_BUCKET=metastatistic
S3_ACCESS_KEY=
S3_SECRET_KEY=
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=
