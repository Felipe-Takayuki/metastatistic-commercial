# Metastatistic — configuração do docker compose.
# Uso:  cp .env.example .env   e ajuste os valores. O arquivo .env NÃO é versionado (.gitignore).
# Tudo é opcional em desenvolvimento: o que ficar vazio usa o valor padrão de desenvolvimento.

# ---------------------------------------------------------------------------
# Ambiente
# ---------------------------------------------------------------------------
# development | production
# Com `production`, auth-tenant-service, gateway e billing-service RECUSAM iniciar se JWT_SECRET_KEY
# ou as credenciais do Stripe forem as de desenvolvimento (ver seções abaixo).
ENVIRONMENT=development

# ---------------------------------------------------------------------------
# Portas expostas no host
# ---------------------------------------------------------------------------
GATEWAY_PORT=8085
API_PORT=8020
R_WORKER_PORT=8011

# ---------------------------------------------------------------------------
# Sessão / autenticação do app
# ---------------------------------------------------------------------------
AUTH_ENABLED=true
# true quando o acesso for por HTTPS (cookies só trafegam em conexão segura)
COOKIE_SECURE=false
# AUTH_ENABLED=false desliga o login E a autorização de tenants no gateway (modo demonstração local, sem isolamento).
# O gateway recusa iniciar com ENVIRONMENT=production se a autorização estiver desligada.

# ---------------------------------------------------------------------------
# JWT (auth-tenant-service emite os tokens; o gateway recebe a MESMA chave)
# Nota: o gateway autentica pela SESSÃO do app (cookie) e pela associação ao tenant, não por este JWT; o `/auth/token`
# não é exposto externamente (ver PLAN.md §7).
# Gere uma com:  openssl rand -hex 32
# Em produção: obrigatória, com pelo menos 32 caracteres e diferente dos valores do repositório.
# ---------------------------------------------------------------------------
JWT_SECRET_KEY=

# ---------------------------------------------------------------------------
# Stripe (billing-service)
# STRIPE_MOCK_MODE=true simula checkout e webhooks (apenas desenvolvimento).
# Em produção: STRIPE_MOCK_MODE=false + chave secreta e segredo do webhook reais
# (Dashboard Stripe > Developers > API keys / Webhooks).
# ---------------------------------------------------------------------------
STRIPE_MOCK_MODE=true
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Garage (armazenamento de objetos compatível com S3: fotos de perfil)
# O serviço `garage-init` cria o layout, o bucket e importa a chave abaixo. O Garage NÃO publica portas no host.
# Os valores padrão de desenvolvimento servem só para uso local — em produção gere os seus:
#   S3_ACCESS_KEY      echo GK$(openssl rand -hex 12)     ("GK" + 24 caracteres hex)
#   S3_SECRET_KEY      openssl rand -hex 32               (64 caracteres hex)
#   GARAGE_RPC_SECRET  openssl rand -hex 32
#   GARAGE_ADMIN_TOKEN openssl rand -base64 32
# Trocar S3_SECRET_KEY depois da primeira subida exige remover a chave antiga:
#   docker compose exec garage /garage key delete --yes <S3_ACCESS_KEY>
# ---------------------------------------------------------------------------
S3_BUCKET=metastatistic
S3_ACCESS_KEY=
S3_SECRET_KEY=
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=

# ---------------------------------------------------------------------------
# Worker R em OUTRA máquina (economiza até 1,5 GB no servidor principal)
# Máquina do worker:   docker compose -f docker-compose.r-worker.yml up -d --build        (+ --profile tls para HTTPS)
# Servidor principal:  docker compose -f docker-compose.yml -f docker-compose.remote-r.yml up -d --build
# O mesmo R_WORKER_TOKEN nas duas máquinas:  openssl rand -hex 32   (mínimo 32 caracteres)
# ---------------------------------------------------------------------------
R_WORKER_TOKEN=
# servidor principal: URL do edge (https://r.seudominio.com, ou http://<ip-privado>:8090 numa rede privada)
R_WORKER_URLS=
# máquina do worker: domínio (perfil tls), em que interface o edge escuta e quanto de dataset manter em cache
R_WORKER_DOMAIN=
R_EDGE_BIND=127.0.0.1
R_EDGE_PORT=8090
R_CACHE_MB=2048
# limite de memória do worker R (padrão 1536m); em VPS pequena sem worker remoto, reduza (ex.: 512m)
R_WORKER_MEM_LIMIT=1536m

# ---------------------------------------------------------------------------
# Stripe: URL do app e preços (billing-service)
# APP_URL: URL pública do app; as URLs de retorno do checkout/portal partem dela (sem ela, localhost:3000).
# STRIPE_PRICE_ID: um preço só -> vale como o preço MENSAL do plano Team. Para cobrir tudo, use os específicos
# (STRIPE_PRICE_TEAM_MONTHLY/_YEARLY, STRIPE_PRICE_ENTERPRISE_MONTHLY/_YEARLY). Sem eles ficam IDs de exemplo (só no mock).
# ---------------------------------------------------------------------------
APP_URL=
STRIPE_PRICE_ID=
STRIPE_PRICE_TEAM_MONTHLY=
STRIPE_PRICE_TEAM_YEARLY=
STRIPE_PRICE_ENTERPRISE_MONTHLY=
STRIPE_PRICE_ENTERPRISE_YEARLY=
